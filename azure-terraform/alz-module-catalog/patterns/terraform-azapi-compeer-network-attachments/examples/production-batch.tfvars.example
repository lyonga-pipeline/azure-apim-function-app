enabled = false
tenant_id = "cccccccc-cccc-cccc-cccc-cccccccccccc"
execution_subscription_id = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
hub = {
 virtual_network_id = "/subscriptions/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/resourceGroups/hub/providers/Microsoft.Network/virtualNetworks/shared-hub-vnet"
 address_space = ["10.0.0.0/16"]
 organization = "Compeer-Financial-Services"
 workspace = "platform-connectivity"
 contract_version = "0.1.0"
 gateway_ready = false # Set only after an approved, tested gateway/inspection decision.
}
# External estate only: include all real on-prem, partner and OTHER environment ranges.
reserved_address_spaces = ["10.169.0.0/16", "172.16.0.0/12"]
deployment_controls = {
 approval_reference = "REPLACE_WITH_APPROVED_CHANGE"
 exclusive_ownership_verified = false # Confirm no other state owns these child IDs.
 shared_hub_gate_configured = false   # Protected common-hub pipeline plus HCP bypass controls.
}
