subscription_id       = "11111111-1111-1111-1111-111111111111"
ownership_confirmed   = true                            # Example only; inventory existing management/onboarding budgets first.
existing_budget_names = ["platform_management_monthly"] # Retained by its existing owner if targeting management.
budgets = {
  subscription = {
    name               = "subscription-monthly"
    amount             = 5000 # Example in subscription billing currency, not a universal recommendation.
    start_date         = "2026-10-01T00:00:00Z"
    end_date           = "2030-10-01T00:00:00Z"
    contact_emails     = ["finops@example.invalid"]
    contact_groups     = []
    approval_reference = "REPLACE-FINOPS-APPROVAL"
  }
}

cost_exports = {
  daily = {
    name                    = "actual-cost-daily"
    container_id            = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/finops-rg/providers/Microsoft.Storage/storageAccounts/replacefinops/blobServices/default/containers/costs"
    root_folder_path        = "subscriptions/network"
    start_date              = "2026-10-01T00:00:00Z"
    end_date                = "2030-10-01T00:00:00Z"
    export_access_confirmed = true # Destination owner confirms Cost Management firewall and RBAC prerequisites.
    cost_type               = "ActualCost"
  }
}

cost_anomalies = { operations = { name = "subscription-anomalies", email_addresses = ["finops@example.invalid"] } }
