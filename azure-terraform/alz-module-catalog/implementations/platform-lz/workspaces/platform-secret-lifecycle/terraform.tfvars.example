#     mode = "manual" # emergency requires a reviewed incident and clean identity.
#     approval_reference = "CHG123"
#     expires_at = "2027-01-02T00:00:00Z"
#     operator_object_ids = ["REPLACE_OPERATOR_OBJECT_UUID"]
#     clean_identity_confirmed = false
#   }
# }
