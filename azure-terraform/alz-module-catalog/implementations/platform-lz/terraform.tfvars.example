}

platform_connectivity = {
  enabled         = true
  subscription_id = "00000000-0000-0000-0000-000000000000"
  resource_group = {
    name = "rg-platform-connectivity-prod"
  }
  hub_vnet = {
    name          = "vnet-hub-prod-centralus-001"
    address_space = ["10.0.0.0/16"]
    dns_servers   = []
    subnets = {
      AzureFirewallSubnet      = { address_prefixes = ["10.0.0.0/26"] }
      GatewaySubnet            = { address_prefixes = ["10.0.0.64/27"] }
      RouteServerSubnet        = { address_prefixes = ["10.0.0.96/27"] }
      AzureBastionSubnet       = { address_prefixes = ["10.0.0.128/26"] }
      app_integration          = { address_prefixes = ["10.0.1.0/24"] }
      private_endpoints        = { address_prefixes = ["10.0.2.0/24"] }
      palo_alto_management     = { address_prefixes = ["10.0.3.0/24"] }
      palo_alto_untrusted      = { address_prefixes = ["10.0.4.0/24"] }
      palo_alto_trusted        = { address_prefixes = ["10.0.5.0/24"] }
    }
  }
  palo_alto = {
    enabled                = false
    deployment_model       = "external"
    panorama_managed       = true
    trusted_subnet_key     = "palo_alto_trusted"
    untrusted_subnet_key   = "palo_alto_untrusted"
    management_subnet_key  = "palo_alto_management"
    private_ip_addresses   = {}
    notes                  = "Contract only until VM-Series deployment and Panorama ownership are approved."
  }
  dns_resolution = {
    enabled                  = false
    mode                     = "dc-forwarders"
    private_resolver_enabled = false
    dns_server_ips           = []
  }
  network_security_groups         = {}
  subnet_nsg_associations         = {}
  route_tables                    = {}
  subnet_route_table_associations = {}
  public_ips                      = {}
  load_balancers                  = {}
  private_dns_zones = {
    app_service   = { name = "privatelink.azurewebsites.net", registration_enabled = false, link_to_hub = true }
    key_vault     = { name = "privatelink.vaultcore.azure.net", registration_enabled = false, link_to_hub = true }
    storage_blob  = { name = "privatelink.blob.core.windows.net", registration_enabled = false, link_to_hub = true }
    storage_queue = { name = "privatelink.queue.core.windows.net", registration_enabled = false, link_to_hub = true }
    storage_file  = { name = "privatelink.file.core.windows.net", registration_enabled = false, link_to_hub = true }
  }
}

