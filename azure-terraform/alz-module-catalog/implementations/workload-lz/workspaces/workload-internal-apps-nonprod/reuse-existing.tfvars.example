# SYNTHETIC REFERENCE VALUES, not approved Compeer deployment inputs.
# Complete UAT configuration reusing this application's EXISTING telemetry, alert and diagnostics.
# From this directory: terraform plan -var-file=reuse-existing.tfvars.example
# The vault and storage below must already belong to this workload state when reusing diagnostics.
# This file does NOT import/adopt resources, discover settings, or migrate ownership automatically.
# Review README.md before changing an existing create configuration to this reuse configuration.
subscription_id              = "11111111-1111-1111-1111-111111111111"
tenant_id                    = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
connectivity_subscription_id = "22222222-2222-2222-2222-222222222222"
private_dns_subscription_id  = "33333333-3333-3333-3333-333333333333"
tfe_organization             = "REPLACE_HCP_ORGANIZATION"
management_workspace_name    = "platform-management"
connectivity_workspace_name  = "platform-connectivity"
governance_workspace_name    = "platform-governance"
use_tfe_outputs              = true
platform_inputs              = {}
environment                  = "uat" # Never share a production component with non-production.

spoke = {
  enabled                       = false # Only enable after approvals and any resource-preserving state handoff.
  appcode                       = "orders"
  domain                        = "internal-apps"
  location                      = "centralus"
  address_space                 = ["10.200.0.0/20"]
  reserved_address_spaces       = ["10.201.0.0/20", "10.40.0.0/16"]
  inspection_address_prefixes   = ["10.40.0.0/16"]
  egress_next_hop_ip            = "10.102.0.4"
  private_endpoint_client_cidrs = ["10.40.10.0/24"]
  allow_azure_provided_dns      = false
  manage_hub_attachment         = false # Both directions and VNet/DNS links stay centrally owned.
  gateway_transit_enabled       = false

  workload_tags = {
    application           = "orders"
    owner                 = "Application Operations"
    source_repo           = "ado://example/workloads/orders"
    criticality_tier      = "tier-2"
    data_classification   = "confidential"
    lifecycle_state       = "active"
    cost_center           = "CC-0000"
    gl_category           = "cloud-infrastructure"
    dr_tier               = "silver"
    application_component = "landing-zone"
    additional_tags       = { support_team = "orders-operations" }
    # The root retains the original time_static-created date.
  }
  subnets = {
    application = {
      address_prefixes              = ["10.200.0.0/24"]
      service_endpoints             = []
      bgp_route_propagation_enabled = false
      delegations                   = {}
      rules = {
        internal-https = {
          description                = "Approved internal clients to the application HTTPS endpoint."
          protocol                   = "Tcp"
          source_port_range          = "*"
          destination_port_range     = "443"
          source_address_prefix      = "10.40.10.0/24"
          destination_address_prefix = "10.200.0.0/24"
          access                     = "Allow"
          priority                   = 300
          direction                  = "Inbound"
        }
      }
      routes = {}
    }
    private_endpoints = {
      address_prefixes              = ["10.200.1.0/27"]
      service_endpoints             = []
      bgp_route_propagation_enabled = false
      delegations                   = {}
      rules                         = {}
      routes                        = {}
    }
  }

  # Still owned by this blueprint. There is no existing_vault_id or existing_storage_id switch.
  # Names below and diagnostic targets MUST match the real, already managed parent resources.
  key_vault = {
    enabled                  = true
    name                     = "orders-cus-uat-vault"
    sku_name                 = "standard"
    secret_readers           = {}
    secret_officer_group_ids = { operators = "99999999-9999-9999-9999-999999999999" }
  }
  storage_accounts = {
    data = {
      enabled                    = true
      name                       = "exordersuatdata01"
      replication_type           = "ZRS"
      delete_retention_days      = 30
      grant_workload_blob_access = false # The existing RBAC owner grants the workload's required access.
    }
    future_archive = { enabled = false, grant_workload_blob_access = false }
  }
  workload_access_group_ids = {
    application_readers = {
      principal_id        = "77777777-7777-7777-7777-777777777777"
      role                = "Reader"
      resource_group_keys = ["application"]
    }
  }

  # ON HOLD until OBS-09/OBS-04 approval. Reuse only an approved SAME-APP, SAME-ENV component.
  # Sharing a LAW is not justification for sharing a component across unrelated applications.
  monitoring = {
    enabled                     = true
    create_application_insights = false
    existing_application_insights = {
      id           = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/orders-cus-uat-operations-rg/providers/Microsoft.Insights/components/orders-cus-uat-appi"
      workspace_id = "/subscriptions/44444444-4444-4444-4444-444444444444/resourceGroups/monitoring/providers/Microsoft.OperationalInsights/workspaces/central-law"
    }
    # External owner grants Monitoring Metrics Publisher to the workload UAMI.
    # Set true only with explicit delegation and no duplicate grant in another state.
    manage_existing_telemetry_access = false
    alerts_enabled                   = true
    create_failed_requests_alert     = false
    existing_failed_requests_alert = {
      id                      = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/orders-cus-uat-operations-rg/providers/Microsoft.Insights/metricAlerts/orders-cus-uat-failed-requests"
      application_insights_id = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/orders-cus-uat-operations-rg/providers/Microsoft.Insights/components/orders-cus-uat-appi"
      action_group_ids        = ["/subscriptions/44444444-4444-4444-4444-444444444444/resourceGroups/monitoring/providers/Microsoft.Insights/actionGroups/platform-primary"]
    }
    # Sampling, thresholds, authentication and network settings are controlled by the existing
    # component/alert owner. Verify approved 100% sampling and the application's SLO there;
    # passing creation-only knobs here would not update or verify externally owned resources.
  }
  # The reused alert ALREADY owns its routing. Do not request a second route or empty contacts.
  operations = {
    create_action_group        = false
    platform_action_group_keys = []
    action_group_ids           = []
    notification_emails        = []
  }

  # false disables NEW diagnostic settings, NOT audit logging. All required coverage is declared.
  # Each setting must already exist, target this exact resource, and send to the contract's LAW.
  diagnostics = {
    enabled = false
    existing_settings = {
      key_vault = {
        id                = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/orders-cus-uat-security-rg/providers/Microsoft.KeyVault/vaults/orders-cus-uat-vault/providers/Microsoft.Insights/diagnosticSettings/external-audit"
        workspace_id      = "/subscriptions/44444444-4444-4444-4444-444444444444/resourceGroups/monitoring/providers/Microsoft.OperationalInsights/workspaces/central-law"
        log_categories    = ["AuditEvent"]
        metric_categories = ["AllMetrics"]
      }
      "storage.data.account" = {
        id                = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/orders-cus-uat-data-rg/providers/Microsoft.Storage/storageAccounts/exordersuatdata01/providers/Microsoft.Insights/diagnosticSettings/external-metrics"
        workspace_id      = "/subscriptions/44444444-4444-4444-4444-444444444444/resourceGroups/monitoring/providers/Microsoft.OperationalInsights/workspaces/central-law"
        log_categories    = []
        metric_categories = ["AllMetrics"]
      }
      "storage.data.blob" = {
        id                = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/orders-cus-uat-data-rg/providers/Microsoft.Storage/storageAccounts/exordersuatdata01/blobServices/default/providers/Microsoft.Insights/diagnosticSettings/external-blob"
        workspace_id      = "/subscriptions/44444444-4444-4444-4444-444444444444/resourceGroups/monitoring/providers/Microsoft.OperationalInsights/workspaces/central-law"
        log_categories    = ["StorageRead", "StorageWrite", "StorageDelete"]
        metric_categories = ["Transaction"]
      }
    }
  }

  backup = null # Optional registration into an existing same-subscription vault/policy; no compute creation.
  # No subscription vending, shared platform vault adoption, budgets or management locks.
}
