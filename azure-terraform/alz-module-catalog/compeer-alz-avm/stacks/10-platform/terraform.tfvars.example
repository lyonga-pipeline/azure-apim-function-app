subscription_id = "00000000-0000-0000-0000-000000000000"
environment     = "prod"
prefix          = "cmp"
location        = "centralus"
enable_resource_locks = true
log_retention_days = 90
platform_private_endpoint_subnet_id = "/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.Network/virtualNetworks/REPLACE/subnets/SharedServicesSubnet"
key_vault_private_dns_zone_ids = [
  "/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.Network/privateDnsZones/privatelink.vaultcore.azure.net"
]
platform_storage_private_endpoints = {
  blob = {
    subresource_name = "blob"
    private_dns_zone_ids = [
      "/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.Network/privateDnsZones/privatelink.blob.core.windows.net"
    ]
  }
  file = {
    subresource_name = "file"
    private_dns_zone_ids = [
      "/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.Network/privateDnsZones/privatelink.file.core.windows.net"
    ]
  }
}
sentinel_enabled = true
sentinel_data_connectors = {
  activity_log = {
    connector_type = "AzureActivity"
    source         = "Azure Activity Log"
    enabled        = true
  }
  defender = {
    connector_type = "MicrosoftDefenderForCloud"
    source         = "Defender for Cloud"
    enabled        = true
  }
}
defender_enabled = false
soc_posture_contract = {
  defender_standard_enabled     = false
  sentinel_enabled              = true
  data_collection_rules_enabled = false
  security_contact_enabled      = false
  notes                         = "Enable paid Defender plans after SOC and cost approval."
}
tags = {
  CostCenter  = "REPLACE_ME"
  Owner       = "REPLACE_ME"
  DataClass   = "Internal"
  Criticality = "Tier1"
}
