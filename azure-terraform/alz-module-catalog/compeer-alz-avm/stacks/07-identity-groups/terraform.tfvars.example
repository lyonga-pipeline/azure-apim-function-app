operational_contracts = {
  conditional_access = {
    phase                = "Phase 1"
    owner                = "Identity"
    implementation_state = "external-system"
    required_controls    = ["MFA", "Compliant device", "Azure management plane apps"]
    notes                = "IAM-08 is tenant-wide and validated outside Terraform to avoid lockout risk."
  }
  break_glass = {
    phase                = "Phase 1"
    owner                = "Identity"
    implementation_state = "external-system"
    required_controls    = ["Two cloud-only accounts", "CA exclusion", "Sign-in alert"]
    notes                = "IAM-04 accounts are deliberately manual; monitoring is implemented through the observability/SOC baseline."
  }
  pim_approval = {
    phase                = "Phase 1"
    owner                = "Identity"
    implementation_state = "external-system"
    required_controls    = ["Eligible assignments", "Approval", "MFA", "Entra ID P2"]
    notes                = "PIM eligibility can be codified in 09-privileged-access; approval/MFA settings remain tenant configuration until provider coverage is confirmed."
  }
}
